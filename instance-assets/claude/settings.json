{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/ubuntu/.claude/hooks/japanese-guard.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "wrap_up",
