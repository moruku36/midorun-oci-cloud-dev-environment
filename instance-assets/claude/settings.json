          {
            "type": "command",
            "command": "python3 /home/ubuntu/.claude/hooks/japanese-guard.py"
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "model": "sonnet"
}
